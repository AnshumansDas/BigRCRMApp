        </div>
        <%-- Div Feedback --%>
        <div id="Feedback" class="modal fade flat-box login-form" tabindex="-1" role="dialog">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                            <span aria-hidden="true">&times;</span>
                        </button>
                        <h4 class="modal-title">Feedback</h4>

                    </div>
                    <div class="modal-body">
                        <asp:UpdatePanel ID="UpFeedBack" runat="server">
                            <ContentTemplate>
                                <div class="form-group">
                                    <asp:TextBox ID="TxtPersonName" runat="server" ClientIDMode="Static" CssClass="form-control myfocus" placeholder="Name"></asp:TextBox>
                                    <asp:RequiredFieldValidator ID="RFVPersonName" runat="server" CssClass="required" ControlToValidate="TxtPersonName" ValidationGroup="feedbackValue" ErrorMessage="Required"></asp:RequiredFieldValidator>
                                </div>
                                <div class="form-group">
                                    <asp:TextBox ID="txtHpNo" onkeypress="return isNumberKey(event)" CssClass="form-control" MaxLength="12" placeholder="Hand Phone No" runat="server"></asp:TextBox>
                                    <asp:RequiredFieldValidator ID="RFVNo" runat="server" CssClass="required" ControlToValidate="txtHpNo" ValidationGroup="feedbackValue" ErrorMessage="Required"></asp:RequiredFieldValidator>
                                </div>
                                <div class="form-group">
                                    <asp:TextBox ID="txtEmail" CssClass="form-control" placeholder="Email Id" runat="server"></asp:TextBox>
                                    <asp:RequiredFieldValidator ID="RFVEmail" runat="server" CssClass="required" ControlToValidate="txtEmail" ValidationGroup="feedbackValue" ErrorMessage="Required"></asp:RequiredFieldValidator>
                                    <asp:RegularExpressionValidator ID="RE_Email" runat="server"
                                        ControlToValidate="txtEmail" ErrorMessage="Invalid email" CssClass="required" ValidationGroup="feedbackValue"
                                        ValidationExpression="\w+([-+.']\w+)*@\w+([-.]\w+)*\.\w+([-.]\w+)*"></asp:RegularExpressionValidator>
                                </div>
                                <div class="form-group">
                                    <asp:TextBox ID="txtSubject" CssClass="form-control" placeholder="Subject" runat="server"></asp:TextBox>
                                    <asp:RequiredFieldValidator ID="RFVSubject" runat="server" CssClass="required" ControlToValidate="txtSubject" ValidationGroup="feedbackValue" ErrorMessage="Required"></asp:RequiredFieldValidator>
                                </div>
                                <div class="form-group">
                                    <asp:TextBox ID="txtMessage" CssClass="form-control" placeholder="Message" Style="height: 100px;" runat="server" TextMode="MultiLine"></asp:TextBox>
                                    <asp:RequiredFieldValidator ID="RFVMessage" runat="server" CssClass="required" ControlToValidate="txtMessage" ValidationGroup="feedbackValue" ErrorMessage="Required"></asp:RequiredFieldValidator>
                                </div>
                                <div id="Div1" runat="server" visible="false" class="form-group">
                                    <span id="Span1" runat="server" style="font-size: smaller;"></span>
                                </div>
                                <asp:LinkButton ID="lnkSubmit" runat="server" OnClick="lnkSubmit_Click" ValidationGroup="feedbackValue" CssClass="btn btn-primary btn-block">Submit</asp:LinkButton>
                            </ContentTemplate>
                        </asp:UpdatePanel>
                    </div>

                </div>
                <!-- /.modal-content -->
            </div>
            <!-- /.modal-dialog -->
        </div>
    </form>
    <!-- single-product-page-wraper end-->
