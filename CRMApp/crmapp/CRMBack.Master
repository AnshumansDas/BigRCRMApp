            <!-- success message-->
            <div class="modal fade" id="ModalAddToCartMsg" tabindex="-1" role="dialog" aria-labelledby="myModalLabel" aria-hidden="true">
                <div class="modal-dialog cascading-modal" role="document">
                    <div class="modal-content">
                        <!--Header-->
                        <div style="text-align: center">
                            <div class="modal-header light-blue darken-3 white-text">
                                <h4 class="title"><i class="fa fa-save"></i>&nbsp;Record save successfully!</h4>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- success message post submitting Feedback-->
            <div class="modal fade" id="ModalFeedbackMsg" tabindex="-1" role="dialog" aria-labelledby="myModalLabel" aria-hidden="true">
                <div class="modal-dialog cascading-modal" role="document">
                    <div class="modal-content">
                        <!--Header-->
                        <div style="text-align: center">
                            <div class="modal-header light-blue darken-3 white-text">
                                <h4 class="title"><i class="fa fa-save"></i>&nbsp;Thank you, your feedback successfully submitted to the administraor!</h4>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- success email message-->
            <div class="modal fade" id="ModalSendEmailMsg" tabindex="-1" role="dialog" aria-labelledby="myModalLabel" aria-hidden="true">
                <div class="modal-dialog cascading-modal" role="document">
                    <div class="modal-content">
                        <!--Header-->
                        <div style="text-align: center">
                            <div class="modal-header light-blue darken-3 white-text">
                                <h4 class="title"><i class="fa fa-save"></i>&nbsp;Thank you, your email sent successfully!</h4>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
